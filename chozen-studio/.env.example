# Copy to .env and fill in. .env is gitignored and never leaves this machine.
# Get a key at https://kie.ai/api-key
KIE_API_KEY=

# Where finished images and videos are saved.
# Default: ~/ChoZenStudio/output
# OUTPUT_DIR=/Users/you/ChoZenStudio/output

# Local server port.
# PORT=4173

# Advanced: point the client at a different API host (proxy or local mock).
# KIE_BASE_URL=https://api.kie.ai
